---
interface Props {
	current?: string;
	class?: string;
}

const current = Astro.props.current ?? '/';
const className = Astro.props.class ?? '';

const tabs: { label: string; href: string }[] = [
	{ label: 'Início', href: '/' },
	{ label: 'Sobre', href: '/about' },
	{ label: 'Projetos', href: '/projects' },
	{ label: 'Experiência', href: '/experience' },
	{ label: 'Pós em IA', href: '/ia' },
	{ label: 'Contato', href: '/contact' },
];

const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<nav class:list([className, 'border-b border-border bg-surface']) aria-label="Navegação principal">
	<ul class="flex flex-wrap items-end gap-x-1 gap-y-0 text-sm md:justify-center">
		{tabs.map((tab) => {
			const active = isCurrent(tab.href);
			return (
				<li>
					<a
						href={tab.href}
						aria-current={active ? 'page' : undefined}
						class:list={{
							'flex items-center gap-1.5 border-b-2 px-3 py-2 text-sm font-medium transition-colors': true,
							'border-accent text-accent': active,
							'border-transparent text-muted hover:text-foreground hover:border-border': !active,
						}}
					>
						<span
							class:list={{
								'mt-0.5 h-1 w-1 rounded-full': true,
								'bg-accent': active,
								'bg-muted': !active,
							}}
							aria-hidden="true"
						></span>
					{tab.label}
						{active && <span class="tab-cursor" aria-hidden="true"></span>}
					</a>
				</li>
			);
		})}
	</ul>
</nav>
