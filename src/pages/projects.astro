---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects } from '../data/projects';

// Filtros curados (grupos com sentido, um por linha no máximo) — não a lista
// bruta de stacks, que virava um muro de 27 botões antes de qualquer conteúdo.
const filters = [
	{ id: 'all', label: 'Todos' },
	{ id: 'web', label: 'Web' },
	{ id: 'android', label: 'Android' },
	{ id: 'ia', label: 'IA' },
	{ id: 'agentes', label: 'Agentes' },
];
---

<BaseLayout title="Projetos — Anderson" description="Projetos de frontend e full stack do Anderson.">
	<section class="space-y-6">
		<div class="space-y-2">
			<h1 class="text-3xl md:text-4xl">Projetos<span class="h1-cursor" aria-hidden="true"></span></h1>
			<p class="text-muted">Alguns trabalhos recentes, cada um com o problema, a stack e o resultado.</p>
		</div>

		<nav class="flex flex-wrap gap-4 text-sm" aria-label="Filtros">
			{filters.map((filter, i) => (
				<button
					type="button"
					data-filter={filter.id}
					class="filter-btn transition hover:opacity-70"
					aria-pressed={i === 0 ? 'true' : 'false'}
				>
					{filter.label}
				</button>
			))}
		</nav>

		<div class="divide-y divide-border" id="project-list">
			{projects.map((project, i) => (
				<div data-tags={(project.tags ?? []).join(',')} class="project-item">
					<ProjectRow project={project} loading={i === 0 ? 'eager' : 'lazy'} />
				</div>
			))}
		</div>
	</section>
</BaseLayout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const items = document.querySelectorAll<HTMLElement>('.project-item');

	const applyFilter = (filter: string) => {
		items.forEach((item) => {
			const tags = item.getAttribute('data-tags')?.split(',') ?? [];
			item.style.display = filter === 'all' || tags.includes(filter) ? '' : 'none';
		});
	};

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const filter = button.getAttribute('data-filter') || 'all';

			buttons.forEach((btn) => {
				const active = btn === button;
				btn.setAttribute('aria-pressed', active ? 'true' : 'false');
			});

			applyFilter(filter);
		});
	});
</script>
